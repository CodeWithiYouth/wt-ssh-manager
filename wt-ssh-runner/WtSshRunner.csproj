<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WtSshRunner</AssemblyName>
    <RootNamespace>WtSshRunner</RootNamespace>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
    <Page Remove="artifacts\**" />
    <Content Remove="artifacts\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\wt-ssh-manager\SshRunner.cs" Link="SshRunner.cs" />
    <Compile Include="..\wt-ssh-manager\SshProfile.cs" Link="SshProfile.cs" />
    <Compile Include="..\wt-ssh-manager\ProfileStore.cs" Link="ProfileStore.cs" />
    <Compile Include="..\wt-ssh-manager\SecretProtector.cs" Link="SecretProtector.cs" />
  </ItemGroup>
</Project>

