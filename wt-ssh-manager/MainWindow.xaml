<Window x:Class="WtSshManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
        xmlns:local="using:WtSshManager">
  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>

  <Grid x:Name="LayoutRoot"
        Background="#F2F5F9"
        SizeChanged="LayoutRoot_SizeChanged">
    <Grid.Resources>
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F2F5F9"/>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#F8FAFD"/>
      <SolidColorBrush x:Key="BorderBrush" Color="#DCE4EE"/>
      <SolidColorBrush x:Key="MutedTextBrush" Color="#667085"/>
      <SolidColorBrush x:Key="BrandBrush" Color="#0F6CBD"/>
      <SolidColorBrush x:Key="BrandSoftBrush" Color="#E7F2FB"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#C4314B"/>

      <Style x:Key="QuietIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Background" Value="#0F6CBD"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#0F6CBD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#344054"/>
        <Setter Property="BorderBrush" Value="#D5DDE8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style>
      <Style x:Key="ProfileListItemStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListViewItem">
              <primitives:ListViewItemPresenter
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  ContentTransitions="{TemplateBinding ContentTransitions}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  Padding="{TemplateBinding Padding}"
                  Background="Transparent"
                  PointerOverBackground="Transparent"
                  PressedBackground="Transparent"
                  SelectedBackground="Transparent"
                  SelectedPointerOverBackground="Transparent"
                  SelectedPressedBackground="Transparent"
                  SelectedBorderBrush="Transparent"
                  SelectedInnerBorderBrush="Transparent"
                  FocusBorderBrush="Transparent"
                  FocusSecondaryBorderBrush="Transparent"
                  SelectionIndicatorVisualEnabled="False"
                  SelectionCheckMarkVisualEnabled="False"/>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="#F9FBFE"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="20,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="SidebarToggleButton"
                Style="{StaticResource QuietIconButtonStyle}"
                Content="☰"
                FontSize="18"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="折叠连接栏"
                Click="SidebarToggleButton_Click"/>

        <Border Grid.Column="1"
                Width="40"
                Height="40"
                CornerRadius="11"
                Background="{StaticResource BrandBrush}"
                VerticalAlignment="Center">
          <Viewbox Width="27" Height="27">
            <Canvas Width="24" Height="24">
              <Path Fill="White"
                    Data="M4,3 H20 C21.7,3 23,4.3 23,6 V18 C23,19.7 21.7,21 20,21 H4 C2.3,21 1,19.7 1,18 V6 C1,4.3 2.3,3 4,3 Z"/>
              <Path Stroke="#0F6CBD"
                    StrokeThickness="1.7"
                    Data="M6,9 L9.5,12 L6,15"/>
              <Path Stroke="#0F6CBD"
                    StrokeThickness="1.7"
                    Data="M12,15 H18"/>
              <Ellipse Fill="#58B7F7" Width="2.6" Height="2.6" Canvas.Left="17" Canvas.Top="6.2"/>
            </Canvas>
          </Viewbox>
        </Border>

        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Spacing="2">
          <TextBlock Text="SSH 连接管理器"
                     FontSize="19"
                     FontWeight="SemiBold"
                     Foreground="#17212F"/>
          <TextBlock Text="安全的远程会话和内嵌终端"
                     FontSize="12"
                     Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Border Grid.Column="3"
                Padding="11,7"
                CornerRadius="16"
                Background="#EAF7F0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <FontIcon Glyph="&#xE72E;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="15"
                      Foreground="#197A49"/>
            <TextBlock Text="DPAPI 已保护"
                       FontSize="12"
                       Foreground="#197A49"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border x:Name="SidebarBorder"
            Grid.Row="1"
            Grid.Column="0"
            Margin="20,14,8,14"
            Padding="14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <Grid x:Name="SidebarLayout">
        <Grid x:Name="SidebarExpandedLayout"
              RowSpacing="13">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid x:Name="SidebarHeader"
                Grid.Row="0"
                ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SidebarTitlePanel" Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="连接档案"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#17212F"/>
                <Border Padding="7,2"
                        CornerRadius="9"
                        Background="{StaticResource BrandSoftBrush}"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="ProfileCountText"
                             Text="0"
                             FontSize="11"
                             Foreground="{StaticResource BrandBrush}"/>
                </Border>
              </StackPanel>
              <TextBlock Text="已保存的 SSH 档案"
                         FontSize="12"
                         Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Style="{StaticResource QuietIconButtonStyle}"
                    ToolTipService.ToolTip="添加连接"
                    Click="AddButton_Click">
              <FontIcon Glyph="&#xE710;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Foreground="{StaticResource BrandBrush}"/>
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Height="40"
                  Background="#F5F7FA"
                  BorderBrush="#D7E0EA"
                  BorderThickness="1"
                  CornerRadius="7">
            <Grid ColumnSpacing="7">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <FontIcon Margin="11,0,0,0"
                        Glyph="&#xE721;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Foreground="#8190A3"
                        VerticalAlignment="Center"/>
              <TextBox x:Name="SearchBox"
                       Grid.Column="1"
                       BorderThickness="0"
                       Background="Transparent"
                       PlaceholderText="搜索连接"
                       FontSize="13"
                       Padding="0"
                       VerticalContentAlignment="Center"
                       TextChanged="SearchBox_TextChanged"/>
            </Grid>
          </Border>

          <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="GroupFilter"
                      Height="36"
                      SelectedIndex="0"
                      FontSize="12"
                      PlaceholderText="全部分组"
                      SelectionChanged="GroupFilter_SelectionChanged">
              <ComboBoxItem Content="全部分组" Tag=""/>
            </ComboBox>
            <CheckBox x:Name="FavoritesOnlyCheckBox"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Content="收藏"
                      FontSize="12"
                      Checked="ProfileFilter_Changed"
                      Unchecked="ProfileFilter_Changed"/>
          </Grid>

          <Grid Grid.Row="3" RowSpacing="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button x:Name="AddButton"
                    Grid.Row="0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Click="AddButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="14"/>
                <TextBlock Text="添加连接"/>
              </StackPanel>
            </Button>

            <ListView x:Name="ProfilesList"
                      Grid.Row="1"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemContainerStyle="{StaticResource ProfileListItemStyle}"
                      SelectionMode="Single"
                      SelectionChanged="ProfilesList_SelectionChanged"
                      DoubleTapped="ProfilesList_DoubleTapped">
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,2"
                          Padding="10,10,12,10"
                          CornerRadius="9"
                          Background="#FFFFFF"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1">
                    <Grid ColumnSpacing="10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="4"
                              CornerRadius="2"
                              Background="{StaticResource BrandBrush}"/>
                      <Border Grid.Column="1"
                              Width="34"
                              Height="34"
                              CornerRadius="9"
                              Background="{StaticResource BrandSoftBrush}"
                              VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE756;"
                                  FontFamily="Segoe Fluent Icons"
                                  FontSize="16"
                                  Foreground="{StaticResource BrandBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                      </Border>
                      <Grid Grid.Column="2" RowSpacing="4">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name}"
                                     FontSize="14"
                                     FontWeight="SemiBold"
                                     Foreground="#17212F"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="1"
                                     Text="{Binding FavoriteLabel}"
                                     FontSize="11"
                                     Foreground="#C88616"
                                     VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                          <FontIcon Glyph="&#xE774;"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="12"
                                    Foreground="#8190A3"/>
                          <TextBlock Text="{Binding Host}"
                                     FontSize="12"
                                     Foreground="#667085"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="7">
                          <TextBlock Text="{Binding Group}"
                                     FontSize="11"
                                     Foreground="#8190A3"/>
                          <TextBlock Text="·"
                                     FontSize="11"
                                     Foreground="#C1CAD6"/>
                          <TextBlock Text="{Binding AuthenticationLabel}"
                                     FontSize="11"
                                     Foreground="#8190A3"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
          </Grid>
        </Grid>

        <StackPanel x:Name="CollapsedRail"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="10">
          <Border Width="32"
                  Height="32"
                  CornerRadius="9"
                  Background="{StaticResource BrandSoftBrush}">
            <FontIcon Glyph="&#xE756;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="16"
                      Foreground="{StaticResource BrandBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
          </Border>
          <Button Style="{StaticResource QuietIconButtonStyle}"
                  ToolTipService.ToolTip="添加连接"
                  Click="AddButton_Click">
            <FontIcon Glyph="&#xE710;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="16"
                      Foreground="{StaticResource BrandBrush}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Grid.Column="1"
            Margin="8,14,20,14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
      <Grid>
        <StackPanel x:Name="EmptyState"
                    Margin="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
          <Border Width="72"
                  Height="72"
                  CornerRadius="21"
                  Background="{StaticResource BrandSoftBrush}"
                  HorizontalAlignment="Center">
            <Viewbox Width="42" Height="42">
              <Canvas Width="24" Height="24">
                <Path Fill="{StaticResource BrandBrush}"
                      Data="M4,3 H20 C21.7,3 23,4.3 23,6 V18 C23,19.7 21.7,21 20,21 H4 C2.3,21 1,19.7 1,18 V6 C1,4.3 2.3,3 4,3 Z"/>
                <Path Stroke="White"
                      StrokeThickness="1.7"
                      Data="M6,9 L9.5,12 L6,15"/>
                <Path Stroke="White"
                      StrokeThickness="1.7"
                      Data="M12,15 H18"/>
              </Canvas>
            </Viewbox>
          </Border>
          <TextBlock Text="选择一个 SSH 连接"
                     FontSize="23"
                     FontWeight="SemiBold"
                     Foreground="#17212F"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="从左侧档案打开内嵌终端，多个会话可以同时保留。"
                     FontSize="13"
                     Foreground="{StaticResource MutedTextBrush}"
                     HorizontalAlignment="Center"/>
          <Border Margin="0,8,0,0"
                  Padding="13,8"
                  CornerRadius="8"
                  Background="#F8FAFD"
                  BorderBrush="#E3E9F1"
                  BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72E;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="14"
                        Foreground="{StaticResource BrandBrush}"/>
              <TextBlock Text="密码使用当前 Windows 用户 DPAPI 加密"
                         FontSize="12"
                         Foreground="#667085"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid x:Name="DetailsPanel"
              Margin="34"
              Visibility="Collapsed"
              RowSpacing="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="62"
                    Height="62"
                    CornerRadius="17"
                    Background="{StaticResource BrandSoftBrush}">
              <FontIcon Glyph="&#xE756;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="27"
                        Foreground="{StaticResource BrandBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="4">
              <TextBlock Text="SSH 连接档案"
                         FontSize="12"
                         Foreground="{StaticResource BrandBrush}"/>
              <TextBlock x:Name="DetailNameText"
                         FontSize="25"
                         FontWeight="SemiBold"
                         Foreground="#17212F"
                         TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE774;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="12"
                          Foreground="#8190A3"/>
                <TextBlock x:Name="DetailHostText"
                           FontSize="13"
                           Foreground="#667085"/>
              </StackPanel>
            </StackPanel>
            <Border Grid.Column="2"
                    Padding="10,6"
                    CornerRadius="14"
                    Background="#F5F7FA"
                    VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="7"
                         Height="7"
                         Fill="#98A2B3"
                         VerticalAlignment="Center"/>
                <TextBlock Text="未连接"
                           FontSize="12"
                           Foreground="#667085"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="1"
                  Padding="18"
                  Background="#F8FAFD"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  CornerRadius="10">
            <Grid RowSpacing="14" ColumnSpacing="28">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="3">
                <TextBlock Text="分组" FontSize="11" Foreground="#8190A3"/>
                <TextBlock x:Name="DetailGroupText" FontSize="13" Foreground="#344054"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="用户" FontSize="11" Foreground="#8190A3"/>
                <TextBlock x:Name="DetailUserText" FontSize="13" Foreground="#344054"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Text="端口" FontSize="11" Foreground="#8190A3"/>
                <TextBlock x:Name="DetailPortText" FontSize="13" Foreground="#344054"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Spacing="3">
                <TextBlock Text="认证方式" FontSize="11" Foreground="#8190A3"/>
                <TextBlock x:Name="DetailAuthenticationText" FontSize="13" Foreground="#344054" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="3">
                <TextBlock Text="连接历史" FontSize="11" Foreground="#8190A3"/>
                <TextBlock x:Name="DetailLastConnectedText" FontSize="13" Foreground="#344054"/>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="2"
                  Padding="13,10"
                  Background="#F4F8FC"
                  BorderBrush="#DCEAF6"
                  BorderThickness="1"
                  CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <FontIcon Glyph="&#xE72E;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{StaticResource BrandBrush}"
                        VerticalAlignment="Center"/>
              <TextBlock Text="保存的密码使用 Windows DPAPI 加密；SSH 会话和终端界面都在此窗口内运行。"
                         FontSize="12"
                         Foreground="#667085"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="3"
                      Orientation="Horizontal"
                      Spacing="9"
                      VerticalAlignment="Top">
            <Button x:Name="ConnectButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="False"
                    Click="ConnectButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE774;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                <TextBlock Text="连接"/>
              </StackPanel>
            </Button>
            <Button x:Name="CopyPasswordButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="CopyPasswordButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                <TextBlock Text="复制密码"/>
              </StackPanel>
            </Button>
            <Button x:Name="EditButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="EditButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                <TextBlock Text="编辑"/>
              </StackPanel>
            </Button>
            <Button x:Name="DeleteButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsEnabled="False"
                    Click="DeleteButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{StaticResource DangerBrush}"/>
                <TextBlock Text="删除" Foreground="{StaticResource DangerBrush}"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <TabView x:Name="TerminalTabs"
                 Visibility="Collapsed"
                 Padding="0"
                 Margin="0"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch"
                 IsAddTabButtonVisible="False"
                 CanReorderTabs="True"
                 TabCloseRequested="TerminalTabs_TabCloseRequested"/>
      </Grid>
    </Border>

    <Border x:Name="StatusBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="20,0,20,10"
            Padding="9,6"
            Background="#F8FAFD"
            BorderBrush="#E0E7EF"
            BorderThickness="1"
            CornerRadius="7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE946;"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="13"
                  Foreground="{StaticResource BrandBrush}"
                  VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText"
                   FontSize="12"
                   Foreground="#667085"
                   Text="密码使用当前 Windows 用户 DPAPI 加密保存。"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>

