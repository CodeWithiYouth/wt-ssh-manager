<ContentDialog x:Class="WtSshManager.ProfileDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="SSH 连接档案"
               PrimaryButtonText="保存"
               CloseButtonText="取消"
               DefaultButton="Primary"
               PrimaryButtonClick="SaveButton_Click">
  <ScrollViewer MaxHeight="620">
    <StackPanel Width="480" Spacing="12">
      <TextBox x:Name="NameBox"
               Header="显示名称"
               PlaceholderText="例如：生产服务器"/>
      <TextBox x:Name="HostBox"
               Header="主机或 SSH 别名"
               PlaceholderText="IP、域名或 ~/.ssh/config 中的 Host 别名"/>
      <TextBox x:Name="GroupBox"
               Header="分组"
               PlaceholderText="默认"/>
      <TextBox x:Name="UsernameBox"
               Header="用户名（可空）"/>
      <TextBox x:Name="StartupCommandBox"
               Header="连接后执行命令（可空）"
               PlaceholderText="例如：htop 或 cline"/>
      <TextBox x:Name="PortBox"
               Header="端口（可空）"/>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="IdentityFileBox"
                 Header="私钥文件（可空）"
                 PlaceholderText="留空使用 SSH 配置或默认密钥"/>
        <Button Grid.Column="1"
                Margin="0,26,0,0"
                Content="浏览…"
                Click="BrowseButton_Click"/>
      </Grid>
      <PasswordBox x:Name="PasswordBox"
                   Header="SSH 密码（可空）"/>
      <CheckBox x:Name="FavoriteBox" Content="收藏此连接"/>
      <TextBlock Text="密码使用当前 Windows 用户的 DPAPI 加密保存在本机。填写密码会优先使用密码认证，并自动交给 OpenSSH；密码不会出现在命令行中。留空则由 OpenSSH 使用密钥或 ssh-agent。"
                 TextWrapping="Wrap"
                 Opacity="0.72"/>
      <TextBlock x:Name="ValidationText"
                 Foreground="Red"
                 TextWrapping="Wrap"
                 Visibility="Collapsed"/>
    </StackPanel>
  </ScrollViewer>
</ContentDialog>

